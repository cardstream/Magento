var GPWindows = [];
window.open = function (open) {
    return function (url, name, features) {
        var _nGPWindow = open.call(window, url, name || "gpay_window", features);
        GPWindows.push(_nGPWindow);
        return _nGPWindow;
    };
}(window.open);
function CloseGPWindows(){
    GPWindows.map(_gpw=>{
        if (!_gpw.closed) _gpw.close();
    });
}
var nParent = null;
window.onload = function (load) {
    return function (e) {
        nParent = window.opener;
        if (load != null) {
            load.call(e);
        }
    }
}(window.onload);

window.onunload = function (unload) {
    return function (e) {
        //promote first branch page to parent
        if (nParent != null && !nParent.closed && GPWindows.length > 0) {
            nParent.GPWindows.push(GPWindows[0]);
            GPWindows[0].nParent = nParent;
        }
        //make first child window new root
        for (var i = 1; i < GPWindows.length; i++) {
            GPWindows[i].nParent = GPWindows[0];
            GPWindows[0].GPWindows.push(GPWindows[i]);
        }
        if (unload != null) {
            unload.call(e);
        }
    }
}(window.onunload);
