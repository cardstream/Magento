if( ($block->checkMethod('applepay') || $block->checkMethod('googlepay')) ){

    $product = $block->getLayout()->getBlock('product.info')->getProduct();
    $product_id = (int)$product->getId(); 

    $price = 0;
    $request = [];

    $currencyCode = $block->getCurrency();
    $countryCode = $block->getCountryCode();
    $settings = $block->settings;

    $buy_url = $this->getUrl("opn/order/process/action/get_totals");
    $shipping_url = $this->getUrl("opn/order/process/action/get_shippings");
    $confirm_url = $this->getUrl("opn/order/process/action/place_order");
    $verify_url = $this->getUrl("opn/order/process/action/verify_merchant");

    if( $product->getTypeId() == 'configurable' ){
        $pricei = $product->getPriceInfo()->getPrice('regular_price');
        $price = (float)trim($pricei->getMinRegularAmount() ?? '');
    } else if( $product->getTypeId() == 'bundle'){
        $price = $product->getPriceInfo()->getPrice('regular_price')->getMinimalPrice()->getValue();
    } else if( $product->getTypeId() == 'grouped' ){
        $instance = $product->getTypeInstance();
        $associatedProducts = $instance->getAssociatedProducts($product);
        foreach ($associatedProducts as $product) {
            $price += round($product->getPrice()* $product->getQty(), 2);
        }
    } else
        $price = (float)trim($product->getPrice() ?? '');

    $price = number_format($price,2,'.','');

    if( $block->checkMethod('applepay') ){
        $request['applepay'] = [
            'countryCode' => $countryCode,
            'currencyCode' => $currencyCode,
            "merchantCapabilities" => [ "supports3DS" ],
            "supportedNetworks" => array_map('strtolower',$settings['apple_allowed_cards']),
            "total" => [
                "label" => $settings['apple_merchant_name'] ?? '',
                "amount" => $price,
            ]
        ];
    }

    if( $block->checkMethod('googlepay') ){
        $request['googlepay'] = [
            'allowed_cards' => $settings['google_allowed_cards'] ?? [],
            'gateway_provider' => $settings['google_gateway_identifier'] ?? '', 
            'merchant_id' => $settings['gateway_id'] ?? '',
            'google_environment' => $settings['google_environment'] ?? 'TEST',
            'google_merchant_name' => $settings['google_merchant_name'] ?? '',
            'google_merchant_id' => $settings['google_merchant_id'] ?? '',
        ];
    }

